# Lokale Entwicklung: Portal-Daten in .claude/lumira-dev statt ~/.lumira und ~/MagicMirror
LUMIRA_HOME=.claude/lumira-dev
LUMIRA_MM_CONFIG=.claude/lumira-dev/MagicMirror/config/config.js
LUMIRA_PORTAL_PORT=8092
LUMIRA_REPO=.claude/lumira-dev/selfupdate/LUMIRA
# Nach einem LUMIRA-Update nicht wirklich beenden (kein systemd im Entwicklungsaufbau)
LUMIRA_NO_SELF_RESTART=1
# Windows: Git Bash statt WSL-bash für ./install.sh --update
LUMIRA_BASH=C:/Program Files/Git/bin/bash.exe
