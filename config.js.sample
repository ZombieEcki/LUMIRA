			header: "Wettervorhersage",
			config: {
				weatherProvider: "openmeteo",
				type: "forecast",
				lat: 48.137,   // <-- ANPASSEN
				lon: 11.575    // <-- ANPASSEN
			}
		},

		// Optional – erst nach Installation des Moduls aktivieren:
