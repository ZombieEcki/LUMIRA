/* MagicMirror² – LUMIRA Konfiguration (Vorlage)
 *
 * Wird bei "./install.sh --no-wizard" verwendet oder als Referenz.
 * Normalerweise erzeugt der Assistent die config.js automatisch.
 *
 * Passe die mit <-- ANPASSEN markierten Stellen an:
 *   - Koordinaten (lat/lon)   - Kalender-URL   - Home-Assistant-URL
 *   - Geburtstage/Hochzeitstag - personName
 */
let config = {
	address: "0.0.0.0",
	port: 8080,
	basePath: "/",
	ipWhitelist: [],

	useHttps: false,
	language: "de",
	locale: "de-DE",
	logLevel: ["INFO", "LOG", "WARN", "ERROR"],
	timeFormat: 24,
	units: "metric",

	modules: [
		{ module: "alert" },
		{ module: "updatenotification", position: "top_bar" },
		{
			module: "clock",
			position: "top_left",
			config: {
				displayType: "digital",
				displaySeconds: false
			}
		},

		/* --- Familienassistent (Sprüche kommen aus den Modul-Defaults) --- */
		{
			module: "MMM-SmartCompliments",
			position: "top_center",
			config: {
				updateInterval: 30000,
				fadeSpeed: 4000,

				// Persönliche Ereignisse  <-- ANPASSEN
				birthdays: [
					// { name: "Max", date: "01-01" }
				],
				birthdayText: "🥳 Happy Birthday, {name}!",
				birthdayReminderDays: 3,
				weddingDate: "",                // <-- ANPASSEN ("JJJJ-MM-TT")
				weddingText: "❤️ Alles Gute zum Hochzeitstag!",
				anniversaryReminderDays: 7,

				// Feuerwehr-Kopplung
				firefighterIntegration: true,
				hideOnAlarmPhases: [1],          // nur im akuten Alarm ausblenden

				// Nachwirkung nach dem Einsatz
				afterDutyEnabled: true,
				afterDutyExclusive: false,
				afterDutyDurationMinutes: 0,

				// Manueller Schalter (Port 8091)
				manualControlEnabled: true,
				manualControlPort: 8091

				// Eigene Sprüche? Siehe modules/MMM-SmartCompliments/CONFIG.md
			}
		},

		/* --- Feuerwehr-Einsatzfenster --- */
		{
			module: "MMM-aPagerAlarm",
			position: "fullscreen_above",
			config: {
				webhookPort: 8090,
				webhookPath: "/alarm",
				title: "EINSATZ",
				readyText: "👷 Bereit machen!",
				personName: "Papa",            // <-- ANPASSEN

				alarmDuration: 15,
				infoDuration: 240,
				returnDuration: 30,

				playSound: true,
				soundFile: "alarm.mp3",
				dimBackground: true,
				showCountdown: true,

				// Home Assistant (optional):
				forwardTargets: [
					// "http://<HA-IP>:8123/api/webhook/feuerwehr_alarm"   // <-- ANPASSEN
				]
			}
		},

		/* --- Familienkalender (iCloud/ICS) --- */
		{
			module: "calendar",
			header: "Familienkalender",
			position: "bottom_left",
			config: {
				maximumEntries: 5,
				calendars: [
					{
						symbol: "calendar-check",
						url: "https://example.com/dein-kalender.ics"   // <-- ANPASSEN (webcal:// -> https://)
					}
				]
			}
		},

		/* --- Wetter (Open-Meteo) --- */
		{
			module: "weather",
			position: "top_right",
			config: {
				weatherProvider: "openmeteo",
				type: "current",
				lat: 52.520,   // <-- ANPASSEN
				lon: 13.405    // <-- ANPASSEN
			}
		},
		{
			module: "weather",
			position: "top_right",
			header: "Das Wetter in",
			config: {
				weatherProvider: "openmeteo",
				type: "forecast",
				lat: 52.520,   // <-- ANPASSEN
				lon: 13.405    // <-- ANPASSEN
			}
		},

		/* --- DWD-Regenradar (benötigt installiertes MMM-RainRadarDWD) – unter der Wettervorhersage --- */
		{
			module: "MMM-RainRadarDWD",
			position: "top_right",
			config: {
				lat: 52.520,              // <-- ANPASSEN
				lon: 13.405,              // <-- ANPASSEN

				alwaysVisible: true,
				showIfRainWithin: 120,

				timePast: 60,
				timeFuture: 120,
				frameStep: 10,

				width: "350px",
				height: "350px",
				border: "none",
				zoomLevel: 9,
				cloudBlur: 12,
				markerSymbol: "fa-home",
				markerColor: "#ff0000",

				showLegend: true,
				legendPosition: "bottom",

				textPast: "PAST",
				textNow: "NOW",
				textForecast: "FORECAST",
				textRainExpected: " - Rain expected:",
				textSnowExpected: " - Snow expected:",
				textSleetExpected: " - Sleet expected:",
				textHailExpected: " - Hail expected:",
				textLoading: "Loading data...",
				textLight: "Light",
				textHeavy: "Heavy",

				animationSpeed: 2000,
				updateInterval: 600000,
				logLevel: "INFO"
			}
		},

		/* --- Nachrichten --- */
		{
			module: "newsfeed",
			position: "bottom_bar",
			config: {
				feeds: [
					{
						title: "Tagesschau",
						url: "https://www.tagesschau.de/infoservices/alle-meldungen-100~rss2.xml"
					}
				],
				showSourceTitle: false,
				showPublishDate: true,
				reloadInterval: 300000,
				updateInterval: 20000,
				maxNewsItems: 10,
				wrapTitle: true,
				wrapDescription: false,
				ignoreOldItems: true,
				ignoreOlderThan: 86400000
			}
		}
	]
};

if (typeof module !== "undefined") { module.exports = config; }
