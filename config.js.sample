		{
			module: "newsfeed",
			position: "bottom_bar",
			config: {
				feeds: [
					{ title: "Tagesschau", url: "https://www.tagesschau.de/xml/rss2/" }
				],
				showSourceTitle: true,
				showPublishDate: true,
				broadcastNewsFeeds: true,
