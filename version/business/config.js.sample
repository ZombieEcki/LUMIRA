/* MagicMirror² – LUMIRA BUSINESS (Basis-Vorlage für die Grundinstallation)
 *
 * Für Unternehmen & Büros – Info-Display ohne Alarmierung und ohne
 * Familien-Inhalte. Siehe ../../concept/produktvarianten.md und ../README.md
 * für den Ablauf der Grundinstallation.
 *
 * Passe die mit <-- ANPASSEN markierten Stellen an, bevor das Gerät zum
 * Kunden geht (die persönliche Feinkonfiguration übernimmt später der
 * Kunde selbst per Self-Service-Portal, siehe ../../concept/selfservice.md).
 */
let config = {
	address: "0.0.0.0",
	port: 8080,
	basePath: "/",
	ipWhitelist: [],

	useHttps: false,
	language: "de",
	locale: "de-DE",
	logLevel: ["INFO", "LOG", "WARN", "ERROR"],
	timeFormat: 24,
	units: "metric",

	modules: [
		{ module: "alert" },
		{ module: "updatenotification", position: "top_bar" },
		{
			module: "clock",
			position: "top_left",
			config: {
				displayType: "digital",
				displaySeconds: false
			}
		},

		/* --- Kalender (z. B. Meetingräume/Termine statt Familientermine) --- */
		{
			module: "calendar",
			header: "Kalender",
			position: "bottom_left",
			config: {
				maximumEntries: 5,
				calendars: [
					{
						symbol: "calendar-check",
						url: "https://example.com/kalender.ics"   // <-- ANPASSEN (webcal:// -> https://)
					}
				]
			}
		},

		/* --- Wetter, Regenradar & Warnungen (eigenes Modul, positioniert sich selbst) ---
		   Ort und Anzeige stehen in ~/.lumira/weather.json bzw. im Portal unter
		   Bildschirm → Wetter; ohne Datei gilt Berlin. --- */
		{ module: "MMM-LumiraWeather" },

		/* --- Nachrichten --- */
		{
			module: "newsfeed",
			position: "bottom_bar",
			config: {
				feeds: [
					{
						title: "Tagesschau",
						url: "https://www.tagesschau.de/infoservices/alle-meldungen-100~rss2.xml"
					}
				],
				showSourceTitle: false,
				showPublishDate: true,
				reloadInterval: 300000,
				updateInterval: 20000,
				maxNewsItems: 10,
				wrapTitle: true,
				wrapDescription: false,
				ignoreOldItems: true,
				ignoreOlderThan: 86400000
			}
		}
	]
};

if (typeof module !== "undefined") { module.exports = config; }
