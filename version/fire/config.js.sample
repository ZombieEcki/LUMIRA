/* MagicMirror² – LUMIRA FIRE (Basis-Vorlage für die Grundinstallation)
 *
 * Für Freiwillige Feuerwehren – Familie + Alarmierung. Siehe
 * ../../concept/produktvarianten.md und ../README.md für den Ablauf der
 * Grundinstallation.
 *
 * Passe die mit <-- ANPASSEN markierten Stellen an, bevor das Gerät zum
 * Kunden geht (die persönliche Feinkonfiguration übernimmt später der
 * Kunde selbst per Self-Service-Portal, siehe ../../concept/selfservice.md).
 */
let config = {
	address: "0.0.0.0",
	port: 8080,
	basePath: "/",
	ipWhitelist: [],

	useHttps: false,
	language: "de",
	locale: "de-DE",
	logLevel: ["INFO", "LOG", "WARN", "ERROR"],
	timeFormat: 24,
	units: "metric",

	modules: [
		{ module: "alert" },
		{ module: "updatenotification", position: "top_bar" },
		/* --- Uhr (eigenes Modul, 16 Designs; Einstellungen in ~/.lumira/clock.json
		   bzw. im Portal unter Bildschirm → Uhr) --- */
		{ module: "MMM-LumiraClock", position: "top_left" },

		/* --- Familienassistent (mit Feuerwehr-Kopplung) --- */
		{
			module: "MMM-SmartCompliments",
			position: "top_center",
			config: {
				updateInterval: 30000,
				fadeSpeed: 4000,

				// Persönliche Ereignisse  <-- ANPASSEN
				birthdays: [
					// { name: "Max", date: "01-01" }
				],
				birthdayText: "🥳 Happy Birthday, {name}!",
				birthdayReminderDays: 3,
				weddingDate: "",                // <-- ANPASSEN ("JJJJ-MM-TT")
				weddingText: "❤️ Alles Gute zum Hochzeitstag!",
				anniversaryReminderDays: 7,

				firefighterIntegration: true,
				hideOnAlarmPhases: [1],          // nur im akuten Alarm ausblenden

				afterDutyEnabled: true,
				afterDutyExclusive: false,
				afterDutyDurationMinutes: 0,

				manualControlEnabled: true,
				manualControlPort: 8091
			}
		},

		/* --- Feuerwehr-Einsatzfenster --- */
		{
			module: "MMM-aPagerAlarm",
			position: "fullscreen_above",
			config: {
				webhookPort: 8090,
				webhookPath: "/alarm",
				title: "EINSATZ",
				readyText: "👷 Bereit machen!",
				personName: "Papa",            // <-- ANPASSEN

				alarmDuration: 15,
				infoDuration: 240,
				returnDuration: 30,

				playSound: true,
				soundFile: "alarm.mp3",
				dimBackground: true,
				showCountdown: true,

				// Home Assistant (optional):
				forwardTargets: [
					// "http://<HA-IP>:8123/api/webhook/feuerwehr_alarm"   // <-- ANPASSEN
				]
			}
		},

		/* --- Kalender (eigenes Modul, 12 Designs; Kalender-Abos und Darstellung in
		   ~/.lumira/calendar.json bzw. im Portal unter Bildschirm → Kalender) --- */
		{ module: "MMM-LumiraCalendar", position: "bottom_left" },

		/* --- Wetter, Regenradar & Warnungen (eigenes Modul, positioniert sich selbst) ---
		   Ort und Anzeige stehen in ~/.lumira/weather.json bzw. im Portal unter
		   Bildschirm → Wetter; ohne Datei gilt Berlin. --- */
		{ module: "MMM-LumiraWeather" },

		/* --- Nachrichten --- */
		{
			module: "newsfeed",
			position: "bottom_bar",
			config: {
				feeds: [
					{
						title: "Tagesschau",
						url: "https://www.tagesschau.de/infoservices/alle-meldungen-100~rss2.xml"
					}
				],
				showSourceTitle: false,
				showPublishDate: true,
				reloadInterval: 300000,
				updateInterval: 20000,
				maxNewsItems: 10,
				wrapTitle: true,
				wrapDescription: false,
				ignoreOldItems: true,
				ignoreOlderThan: 86400000
			}
		}
	]
};

if (typeof module !== "undefined") { module.exports = config; }
