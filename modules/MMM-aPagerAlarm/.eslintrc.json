{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "globals": {
    "Module": "readonly",
    "Log": "readonly",
    "MM": "readonly"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }]
  }
}
